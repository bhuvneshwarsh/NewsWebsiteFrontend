{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/s/*",
      "rewrite": "/api/og/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/images/*",
      "/css/*",
      "/assets/*",
      "*.css",
      "*.js",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.ico",
      "*.webp",
      "*.pdf",
      "*.woff",
      "*.woff2"
    ]
  },
  "mimeTypes": {
    ".js": "application/javascript",
    ".jsx": "application/javascript",
    ".ts": "application/javascript",
    ".tsx": "application/javascript",
    ".json": "application/json"
  }
}
